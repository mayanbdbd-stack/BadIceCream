<Page
    x:Class="BadIceCream.Pages.ForgotPassword"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <!-- Back button (top left corner) -->
        <Button x:Name="BackButton"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Click="BackButton_Click">
            <Image Source="ms-appx:///Assets/Buttons/Back.png" Width="64" Height="64"/>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Forgot Password"
                       Style="{StaticResource TitleTextStyle}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource PanelStyle}" Width="380">
                <StackPanel>

                    <TextBlock Text="Enter your username and choose a new password."
                               Style="{StaticResource NormalTextStyle}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBox x:Name="UsernameInput"
                             Header="Username"
                             PlaceholderText="Enter your username"/>

                    <PasswordBox x:Name="NewPasswordInput"
                                 Header="New password"
                                 PlaceholderText="Choose a new password"
                                 Margin="0,12,0,0"/>

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Header="Confirm new password"
                                 PlaceholderText="Type the new password again"
                                 Margin="0,12,0,0"/>

                    <!-- Reset button (later: change the password in the database) -->
                    <Button x:Name="ResetButton"
                            Style="{StaticResource ImageButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                        <Grid Width="180" Height="87">
                            <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                            <TextBlock Text="Reset" Style="{StaticResource ButtonTextStyle}" FontSize="22"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
