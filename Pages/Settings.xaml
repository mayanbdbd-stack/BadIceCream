<Page
    x:Class="BadIceCream.Pages.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <!-- Back button (top left corner) -->
        <Button x:Name="BackButton"
                Style="{StaticResource FrostButtonStyle}"
                Width="64" Height="64"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Click="BackButton_Click">
            <Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
            </Button.Tag>
            <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Settings"
                       Style="{StaticResource TitleTextStyle}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource PanelStyle}" Width="400">
                <StackPanel>

                    <!-- Sound on / off: click the button to switch.
                         There are two buttons, only one of them is shown each time. -->
                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="SoundOnButton"
                                Style="{StaticResource FrostButtonStyle}"
                                Width="64" Height="64"
                                Click="SoundButton_Click">
                            <Button.Tag>
                                <Image Source="ms-appx:///Assets/Buttons/SoundOnCracked.png"/>
                            </Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/SoundOn.png"/>
                        </Button>

                        <Button x:Name="SoundOffButton"
                                Style="{StaticResource FrostButtonStyle}"
                                Width="64" Height="64"
                                Visibility="Collapsed"
                                Click="SoundButton_Click">
                            <Button.Tag>
                                <Image Source="ms-appx:///Assets/Buttons/SoundOffCracked.png"/>
                            </Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/SoundOff.png"/>
                        </Button>

                        <TextBlock Text="Sound"
                                   Style="{StaticResource NormalTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Music on / off (same as the sound) and music volume 0 - 100 -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">

                        <Button x:Name="MusicOnButton"
                                Style="{StaticResource FrostButtonStyle}"
                                Width="64" Height="64"
                                Click="MusicButton_Click">
                            <Button.Tag>
                                <Image Source="ms-appx:///Assets/Buttons/MusicOnCracked.png"/>
                            </Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/MusicOn.png"/>
                        </Button>

                        <Button x:Name="MusicOffButton"
                                Style="{StaticResource FrostButtonStyle}"
                                Width="64" Height="64"
                                Visibility="Collapsed"
                                Click="MusicButton_Click">
                            <Button.Tag>
                                <Image Source="ms-appx:///Assets/Buttons/MusicOffCracked.png"/>
                            </Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/MusicOff.png"/>
                        </Button>

                        <Slider x:Name="VolumeSlider"
                                Header="Music"
                                Width="260"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Controls (information only) -->
                    <TextBlock Text="Controls"
                               Style="{StaticResource NormalTextStyle}"
                               FontWeight="Bold"
                               Margin="0,24,0,8"/>

                    <TextBlock Text="Arrows / WASD - move"
                               Style="{StaticResource NormalTextStyle}"/>

                    <TextBlock Text="Space - build or break a wall"
                               Style="{StaticResource NormalTextStyle}"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
