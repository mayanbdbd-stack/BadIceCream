<Page
    x:Class="BadIceCream.Pages.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <!-- Back button (top left corner) -->
        <Button x:Name="BackButton"
                Style="{StaticResource FrostButtonStyle}"
                Width="64" Height="64"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Click="BackButton_Click">
            <Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
            </Button.Tag>
            <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
        </Button>

        <!-- Go to the login page (top right corner) -->
        <Button x:Name="LoginButton"
                Style="{StaticResource FrostButtonStyle}"
                Width="150" Height="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                Click="LoginButton_Click">
            <Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/LoginButtonCracked.png"/>
            </Button.Tag>
            <Image Source="ms-appx:///Assets/Buttons/LoginButton.png"/>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Register"
                       Style="{StaticResource TitleTextStyle}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource PanelStyle}" Width="380">
                <StackPanel>

                    <TextBox x:Name="UsernameInput"
                             Header="Username"
                             PlaceholderText="Choose a username"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Header="Password"
                                 PlaceholderText="Choose a password"
                                 Margin="0,12,0,0"/>

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Header="Confirm password"
                                 PlaceholderText="Type the password again"
                                 Margin="0,12,0,0"/>

                    <!-- Register button (later: save the new user in the database) -->
                    <Button x:Name="RegisterButton"
                            Style="{StaticResource FrostButtonStyle}"
                            Width="200" Height="80"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                        <Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/RegisterButtonCracked.png"/>
                        </Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/RegisterButton.png"/>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
