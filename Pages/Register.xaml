<Page
    x:Class="BadIceCream.Pages.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <!-- Back button (top left corner) -->
        <Button x:Name="BackButton"
                Style="{StaticResource ImageButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Click="BackButton_Click">
            <Image Source="ms-appx:///Assets/Buttons/Back.png" Width="64" Height="64"/>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Register"
                       Style="{StaticResource TitleTextStyle}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource PanelStyle}" Width="380">
                <StackPanel>

                    <TextBox x:Name="UsernameInput"
                             Header="Username"
                             PlaceholderText="Choose a username"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Header="Password"
                                 PlaceholderText="Choose a password"
                                 Margin="0,12,0,0"/>

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Header="Confirm password"
                                 PlaceholderText="Type the password again"
                                 Margin="0,12,0,0"/>

                    <!-- Register button (later: save the new user in the database) -->
                    <Button x:Name="RegisterButton"
                            Style="{StaticResource ImageButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                        <Grid Width="180" Height="87">
                            <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                            <TextBlock Text="Register" Style="{StaticResource ButtonTextStyle}" FontSize="22"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
