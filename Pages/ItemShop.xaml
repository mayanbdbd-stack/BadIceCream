<Page
    x:Class="BadIceCream.Pages.ItemShop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <!-- Back button (top left corner) -->
        <Button x:Name="BackButton"
                Style="{StaticResource FrostButtonStyle}"
                Width="64" Height="64"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Click="BackButton_Click">
            <Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
            </Button.Tag>
            <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
        </Button>

        <!-- Coins (top right corner) -->
        <Border Style="{StaticResource PanelStyle}"
                Padding="16,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24">
            <TextBlock x:Name="CoinsText"
                       Text="Coins: 0"
                       Style="{StaticResource NormalTextStyle}"
                       FontWeight="Bold"/>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Shop"
                       Style="{StaticResource TitleTextStyle}"
                       Margin="0,0,0,8"/>

            <!-- ===== Characters ===== -->
            <TextBlock Text="Characters"
                       Style="{StaticResource NormalTextStyle}"
                       FontWeight="Bold"
                       Margin="8,0"/>

            <StackPanel Orientation="Horizontal">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Ellipse Width="60" Height="60" Fill="#EBD9A8"/>
                        <TextBlock Text="Vanilla" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center" IsEnabled="False">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGray.png"/>
                                <TextBlock Text="Owned" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Ellipse Width="60" Height="60" Fill="#7B4A2E"/>
                        <TextBlock Text="Chocolate" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                                <TextBlock Text="Buy 50" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Ellipse Width="60" Height="60" Fill="#F4A3B8"/>
                        <TextBlock Text="Strawberry" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                                <TextBlock Text="Buy 100" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ===== Backgrounds ===== -->
            <TextBlock Text="Backgrounds"
                       Style="{StaticResource NormalTextStyle}"
                       FontWeight="Bold"
                       Margin="8,8,8,0"/>

            <StackPanel Orientation="Horizontal">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/Backgrounds/Ice.png" Height="60" Stretch="UniformToFill"/>
                        <TextBlock Text="Ice" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center" IsEnabled="False">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGray.png"/>
                                <TextBlock Text="Owned" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/Backgrounds/Night.png" Height="60" Stretch="UniformToFill"/>
                        <TextBlock Text="Night" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                                <TextBlock Text="Buy 80" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/Backgrounds/Candy.png" Height="60" Stretch="UniformToFill"/>
                        <TextBlock Text="Candy" Style="{StaticResource NormalTextStyle}" HorizontalAlignment="Center" Margin="0,8"/>
                        <Button Style="{StaticResource ImageButtonStyle}" HorizontalAlignment="Center">
                            <Grid Width="120" Height="58">
                                <Image Source="ms-appx:///Assets/Buttons/ButtonGreen.png"/>
                                <TextBlock Text="Buy 150" Style="{StaticResource ButtonTextStyle}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
