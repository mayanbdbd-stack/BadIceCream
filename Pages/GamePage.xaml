<Page
    x:Class="BadIceCream.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:classes="using:BadIceCream.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="*"/>     <!-- game board -->
        </Grid.RowDefinitions>

        <!-- Top bar: back button, level name, time and score -->
        <Grid Grid.Row="0" Margin="24,12">

            <Button x:Name="BackButton"
                    Style="{StaticResource FrostButtonStyle}"
                    Width="56" Height="56"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click">
                <Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
                </Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
            </Button>

            <TextBlock Text="Level 1"
                       Style="{StaticResource NormalTextStyle}"
                       FontSize="28"
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Border Style="{StaticResource PanelStyle}"
                    Padding="16,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TimeText"
                               Text="Time: 0"
                               Style="{StaticResource NormalTextStyle}"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="ScoreText"
                               Text="Score: 0"
                               Style="{StaticResource NormalTextStyle}"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Game board: 18 x 12 squares, every square is 40 x 40.
             GameBoard is the engine's Scene (a Canvas that holds all the game objects) -->

        <Border Grid.Row="1"
                BorderBrush="#4DA6D4"
                BorderThickness="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,16">
            <classes:GameBoard x:Name="Board" Width="720" Height="480">
                <classes:GameBoard.Background>
                    <ImageBrush ImageSource="ms-appx:///Assets/Backgrounds/Ice.png"/>
                </classes:GameBoard.Background>
            </classes:GameBoard>
        </Border>
    </Grid>
</Page>
