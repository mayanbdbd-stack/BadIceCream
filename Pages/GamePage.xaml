<Page
    x:Class="BadIceCream.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:classes="using:BadIceCream.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- top bar -->
            <RowDefinition Height="*"/>     <!-- game board -->
        </Grid.RowDefinitions>

        <!-- Top bar: back button, stage name, time and score.
             The buttons on this page have IsTabStop="False" so they never get keyboard focus:
             otherwise Space (build/break ice) would also "click" the focused button -->
        <Grid Grid.Row="0" Margin="24,12">

            <Button x:Name="BackButton"
                    Style="{StaticResource FrostButtonStyle}"
                    Width="56" Height="56"
                    HorizontalAlignment="Left"
                    IsTabStop="False"
                    Click="BackButton_Click">
                <Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
                </Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
            </Button>

            <TextBlock x:Name="StageText"
                       Text="Stage 1-1"
                       Style="{StaticResource NormalTextStyle}"
                       FontSize="28"
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Border Style="{StaticResource PanelStyle}"
                    Padding="16,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TimeText"
                               Text="Time: 2:00"
                               Style="{StaticResource NormalTextStyle}"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="ScoreText"
                               Text="Score: 0"
                               Style="{StaticResource NormalTextStyle}"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Game board: 18 x 12 squares, every square is 40 x 40.
             GameBoard is the engine's Scene (a Canvas that holds all the game objects).
             The Viewbox makes the whole board bigger to fill the free space on any screen
             (the game still works in 40 x 40 squares, only the picture on the screen grows) -->
        <Viewbox Grid.Row="1" Margin="24,0,24,16">
            <Border BorderBrush="#4DA6D4" BorderThickness="4">
                <classes:GameBoard x:Name="Board" Width="720" Height="480">
                    <classes:GameBoard.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/Backgrounds/Ice.png"/>
                    </classes:GameBoard.Background>
                </classes:GameBoard>
            </Border>
        </Viewbox>

        <!-- End of stage panel (hidden while playing): won or lost, the score, and Retry / Next / Home -->
        <Border x:Name="EndPanel"
                Grid.RowSpan="2"
                Style="{StaticResource PanelStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EndTitle"
                           Text="Stage complete!"
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="40"/>
                <TextBlock x:Name="EndScore"
                           Text="Score: 0"
                           Style="{StaticResource NormalTextStyle}"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button x:Name="RetryButton"
                            Style="{StaticResource FrostButtonStyle}"
                            Width="72" Height="72"
                            Margin="8,0"
                            IsTabStop="False"
                            Click="RetryButton_Click">
                        <Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/RetryCracked.png"/>
                        </Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/Retry.png"/>
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{StaticResource FrostButtonStyle}"
                            Width="72" Height="72"
                            Margin="8,0"
                            IsTabStop="False"
                            Click="NextButton_Click">
                        <Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/NextCracked.png"/>
                        </Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/Next.png"/>
                    </Button>

                    <Button x:Name="HomeButton"
                            Style="{StaticResource FrostButtonStyle}"
                            Width="72" Height="72"
                            Margin="8,0"
                            IsTabStop="False"
                            Click="BackButton_Click">
                        <Button.Tag>
                            <Image Source="ms-appx:///Assets/Buttons/HomeCracked.png"/>
                        </Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/Home.png"/>
                    </Button>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
