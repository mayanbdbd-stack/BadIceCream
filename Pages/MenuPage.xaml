<Page
    x:Class="BadIceCream.Pages.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundImage}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="BAD ICE CREAM"
                       Style="{StaticResource TitleTextStyle}"/>

            <TextBlock Text="Collect the fruit. Escape the monsters."
                       Style="{StaticResource NormalTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,32"/>

            <!-- Play (big button) -->
            <Button x:Name="PlayButton"
                    Style="{StaticResource FrostButtonStyle}"
                    Width="420" Height="104"
                    HorizontalAlignment="Center"
                    Click="PlayButton_Click">
                <Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/PlayCracked.png"/>
                </Button.Tag>
                <Image Source="ms-appx:///Assets/Buttons/Play.png"/>
            </Button>

            <!-- Log in and Register: one bar split into two buttons (no space between them) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">

                <Button x:Name="LoginButton"
                        Style="{StaticResource FrostButtonStyle}"
                        Width="210" Height="74"
                        Click="LoginButton_Click">
                    <Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/LoginCracked.png"/>
                    </Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/Login.png"/>
                </Button>

                <Button x:Name="RegisterButton"
                        Style="{StaticResource FrostButtonStyle}"
                        Width="210" Height="74"
                        Click="RegisterButton_Click">
                    <Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/RegisterCracked.png"/>
                    </Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/Register.png"/>
                </Button>

            </StackPanel>

            <!-- Shop, Leaderboard and Settings (small buttons) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">

                <Button x:Name="ShopButton"
                        Style="{StaticResource FrostButtonStyle}"
                        Width="92" Height="92"
                        Margin="12,0"
                        Click="ShopButton_Click">
                    <Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/ShopCracked.png"/>
                    </Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/Shop.png"/>
                </Button>

                <Button x:Name="LeaderboardButton"
                        Style="{StaticResource FrostButtonStyle}"
                        Width="92" Height="92"
                        Margin="12,0"
                        Click="LeaderboardButton_Click">
                    <Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/LeaderboardCracked.png"/>
                    </Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/Leaderboard.png"/>
                </Button>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource FrostButtonStyle}"
                        Width="92" Height="92"
                        Margin="12,0"
                        Click="SettingsButton_Click">
                    <Button.Tag>
                        <Image Source="ms-appx:///Assets/Buttons/SettingsCracked.png"/>
                    </Button.Tag>
                    <Image Source="ms-appx:///Assets/Buttons/Settings.png"/>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
