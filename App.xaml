<Application
    x:Class="BadIceCream.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream"
    RequestedTheme="Light">

    <Application.Resources>

        <!-- Text color of the game -->
        <SolidColorBrush x:Key="TextBrush" Color="#1B3A4B"/>

        <!-- Background picture of the pages -->
        <ImageBrush x:Key="BackgroundImage"
                    ImageSource="ms-appx:///Assets/Backgrounds/MenuBackground.png"
                    Stretch="UniformToFill"/>

        <!-- The buttons are pictures, so no color behind them (also when the mouse is over / pressed) -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>

        <!-- Button that shows a picture -->
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Frost button: shows a picture, and changes to the cracked picture when the mouse is over it.
             Inside the button put the normal picture, and in Button.Tag put the cracked picture. -->
        <Style x:Key="FrostButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <!-- The pictures fade into each other in 0.12 seconds -->
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12"/>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Normal"/>

                                    <!-- Mouse over the button: show the cracked picture -->
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NormalPicture" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="CrackedPicture" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>

                                    <!-- Button pressed: keep the cracked picture -->
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NormalPicture" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="CrackedPicture" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- The normal picture (inside the button) -->
                            <ContentPresenter x:Name="NormalPicture"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"/>

                            <!-- The cracked picture (from Tag), hidden until the mouse is over the button -->
                            <ContentPresenter x:Name="CrackedPicture"
                                              Content="{TemplateBinding Tag}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text on top of a candy button -->
        <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Big title text -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="52"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Normal text -->
        <Style x:Key="NormalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- White see-through box -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- White card (shop items) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

    </Application.Resources>
</Application>
