<Application
    x:Class="BadIceCream.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BadIceCream"
    RequestedTheme="Light">

    <Application.Resources>

        <!-- Text color of the game -->
        <SolidColorBrush x:Key="TextBrush" Color="#1B3A4B"/>

        <!-- Background picture of the pages -->
        <ImageBrush x:Key="BackgroundImage"
                    ImageSource="ms-appx:///Assets/Backgrounds/MenuBackground.png"
                    Stretch="UniformToFill"/>

        <!-- The buttons are pictures, so no color behind them (also when the mouse is over / pressed) -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>

        <!-- Button that shows a picture -->
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Text on top of a candy button -->
        <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Big title text -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="52"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Normal text -->
        <Style x:Key="NormalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- White see-through box -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- White card (shop items) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

    </Application.Resources>
</Application>
